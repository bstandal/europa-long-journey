{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelongwest.invalid/schemas/editorial.schema.json",
  "title": "Backstage editorial records",
  "$defs": {
    "StableID": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "EditorialEnding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "title", "consequence"],
      "properties": {
        "period": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 }
      }
    },
    "EditorialContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractID",
        "contentID",
        "title",
        "period",
        "thesis",
        "causalSpine",
        "requiredEmphases",
        "governingJudgement",
        "ending",
        "handoff",
        "editorApproval",
        "lockedOnApproval",
        "factLock"
      ],
      "properties": {
        "contractID": { "type": "string", "pattern": "^contract-[0-9]{2}$" },
        "contentID": { "$ref": "#/$defs/StableID" },
        "title": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "thesis": { "type": "string", "minLength": 1 },
        "causalSpine": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredEmphases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "governingJudgement": { "type": "string", "minLength": 1 },
        "ending": { "$ref": "#/$defs/EditorialEnding" },
        "handoff": { "type": "string", "minLength": 1 },
        "editorApproval": { "type": "string", "enum": ["DRAFT_PENDING", "APPROVED"] },
        "lockedOnApproval": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "thesis",
              "causalSpine",
              "requiredEmphases",
              "governingJudgement",
              "ending",
              "handoff"
            ]
          }
        },
        "factLock": { "type": ["string", "null"], "format": "date" }
      }
    },
    "VerifierFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingID",
        "contentID",
        "claimID",
        "result",
        "defectCode",
        "sourceBasis",
        "smallestCorrection",
        "status"
      ],
      "properties": {
        "findingID": { "$ref": "#/$defs/StableID" },
        "contentID": { "$ref": "#/$defs/StableID" },
        "claimID": { "$ref": "#/$defs/StableID" },
        "result": {
          "type": "string",
          "enum": ["PASS", "NARROW", "REPLACE", "REMOVE", "EDITOR_DECISION"]
        },
        "defectCode": {
          "type": ["string", "null"],
          "enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", null]
        },
        "sourceBasis": { "type": "string", "minLength": 1 },
        "smallestCorrection": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/EditorialContract" },
    { "$ref": "#/$defs/VerifierFinding" }
  ]
}
