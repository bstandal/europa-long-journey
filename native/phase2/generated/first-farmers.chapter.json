          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-more-mouths-eyebrow",
              "launchEnglish": "5500–4000 BC · The Danube and Loess Belt"
            },
            "heading": {
              "id": "beat-first-farmers-more-mouths-heading",
              "launchEnglish": "One Hearth Becomes Several"
            },
            "paragraphs": [
              {
                "id": "ff-growth-01",
                "launchEnglish": "Stored harvests and settled care allow households to grow. One roof becomes several. New hearths require new fields. New herds cut lanes between water, pasture and enclosure. The settlement begins to press beyond its first clearing."
              },
              {
                "id": "ff-growth-02",
                "launchEnglish": "Open the ground. Every new household carries seed and animals outward, but leaves roads, field edges and daughter settlements behind."
              }
            ],
            "actionPrompt": {
              "id": "beat-first-farmers-more-mouths-action-prompt",
              "launchEnglish": "Let the household become a landscape"
