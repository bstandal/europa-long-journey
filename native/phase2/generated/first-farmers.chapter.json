        },
        {
          "id": "beat-first-farmers-frontier-consequence",
          "sceneID": "scene-first-farmers-danube-to-loess",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-frontier-consequence-eyebrow",
              "launchEnglish": "The Danube Opens North"
            },
            "heading": {
              "id": "beat-first-farmers-frontier-consequence-heading",
              "launchEnglish": "The Frontier Enters the Household"
            },
            "paragraphs": [
              {
                "id": "ff-frontier-consequence-01",
                "launchEnglish": "The river frontier does not vanish. It moves inside the new settlements. Local knowledge joins imported seed. Older routes carry new cargo. Households combine people whose childhoods began in different worlds. Farming advances, but the continent it remakes enters the system with it."
              },
              {
                "id": "ff-frontier-consequence-02",
                "launchEnglish": "Upstream, the route reaches deep loess: ground that yields to cultivation and timber that can raise a house. Grain can now outlast a season. The next house plot must outlast its first timbers."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-frontier-consequence-01",
            "narration-ff-frontier-consequence-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        }
      ]
    },
    {
      "id": "first-farmers-arc-03",
      "title": {
        "id": "first-farmers-arc-03-title",
        "launchEnglish": "The House Outlives Its Builders"
      },
      "targetDurationMinutes": 10,
      "situation": {
        "id": "first-farmers-arc-03-situation",
        "launchEnglish": "Timber houses decay while repeated rebuilding fixes communities to the same European ground."
      },
      "mechanism": {
        "id": "first-farmers-arc-03-mechanism",
        "launchEnglish": "Household growth, field clearance, herd traffic and settlement memory expand across the loess plains."
      },
      "turn": {
        "id": "first-farmers-arc-03-turn",
        "launchEnglish": "A family economy becomes a demographic force able to remake whole landscapes."
      },
      "consequence": {
        "id": "first-farmers-arc-03-consequence",
        "launchEnglish": "Europe becomes a continent of fields, herds and long-lived settlements."
      },
      "handoff": {
        "id": "first-farmers-arc-03-handoff",
        "launchEnglish": "That settled order now faces a mobile power arriving from the steppe."
      },
      "beats": [
        {
          "id": "beat-first-farmers-raise-longhouse",
          "sceneID": "scene-first-farmers-longhouse-assembly",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-raise-longhouse-eyebrow",
              "launchEnglish": "5600–4900 BC · The Loess Plains"
            },
            "heading": {
              "id": "beat-first-farmers-raise-longhouse-heading",
              "launchEnglish": "Raise the House"
            },
            "paragraphs": [
              {
                "id": "ff-house-01",
                "launchEnglish": "The plot begins as cuts in the soil. Posts must carry the frame. The hearth must sit where work, food and warmth can return each day. Storage must remain dry and close enough to guard. A roof must bind the parts into shelter."
              },
              {
                "id": "ff-house-02",
                "launchEnglish": "Raise the load-bearing frame. Then make the shelter fit for a household. Every piece changes what the household can preserve, repair and pass forward."
              }
            ],
            "actionPrompt": {
              "id": "beat-first-farmers-raise-longhouse-action-prompt",
              "launchEnglish": "Build the house that can be rebuilt"
            }
          },
          "narrationCueIDs": [
            "narration-ff-house-01",
            "narration-ff-house-02"
          ],
