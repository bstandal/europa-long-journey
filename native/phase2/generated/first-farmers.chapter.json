        {
          "id": "beat-first-farmers-before-steppe",
          "sceneID": "scene-first-farmers-steppe-handoff",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-before-steppe-eyebrow",
              "launchEnglish": "By 3300 BC"
            },
            "heading": {
              "id": "beat-first-farmers-before-steppe-heading",
              "launchEnglish": "Europe Had Become a Continent of Fields, Herds and Long-Lived Settlements"
            },
            "paragraphs": [
              {
                "id": "ff-ending-01",
                "launchEnglish": "Their voices were never written down. Their structure remains. Seed grain kept for sowing, a store raised from damp, a field cleared for another year and a house rebuilt beside its dead have fixed growing populations to inherited ground."
              },
              {
                "id": "ff-ending-02",
                "launchEnglish": "East of this settled continent, another order is gathering power across open grass. It will not meet an empty Europe. It will meet fields to seize, stores to command, houses to inherit and paternal lines to reorder."
              }
            ]
          },
          "narrationCueIDs": [
