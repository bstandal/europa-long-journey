  "id": "first-farmers",
  "title": {
    "id": "chapter-first-farmers-title",
    "launchEnglish": "The First Farmers"
  },
  "period": {
    "id": "chapter-first-farmers-period",
    "launchEnglish": "7000–3300 BC"
  },
  "arcs": [
    {
      "id": "first-farmers-arc-01",
      "title": {
        "id": "first-farmers-arc-01-title",
        "launchEnglish": "The River Before the Fields"
      },
      "targetDurationMinutes": 9,
      "situation": {
        "id": "first-farmers-arc-01-situation",
        "launchEnglish": "The first farming households reach a European river world already anchored by settlement, burial and exchange."
      },
      "mechanism": {
        "id": "first-farmers-arc-01-mechanism",
        "launchEnglish": "People carry seed, livestock, tools and learned routines together across the Aegean and into the Danube corridor."
      },
      "turn": {
        "id": "first-farmers-arc-01-turn",
        "launchEnglish": "The field arrives as a complete living system rather than an isolated crop."
      },
      "consequence": {
        "id": "first-farmers-arc-01-consequence",
        "launchEnglish": "Europe's inhabited river frontier becomes the meeting place of two durable ways of life."
      },
      "handoff": {
        "id": "first-farmers-arc-01-handoff",
        "launchEnglish": "Arrival creates the harder problem: a harvest must now carry a household through the year."
      },
      "beats": [
        {
          "id": "beat-first-farmers-river-world",
          "sceneID": "scene-first-farmers-iron-gates-dawn",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-river-world-eyebrow",
              "launchEnglish": "c. 7000 BC · The Iron Gates"
            },
            "heading": {
              "id": "beat-first-farmers-river-world-heading",
              "launchEnglish": "The River Already Held a World"
            },
            "paragraphs": [
              {
                "id": "ff-river-world-01",
                "launchEnglish": "Mist lies inside the Danube gorge. A net lifts silver from the current. Smoke rises from a house set back from the water. Beside the settlement, the dead hold this bank to generations already gone. The gorge is no empty passage. It has paths, landing places, fishing grounds and remembered ground."
              },
              {
                "id": "ff-river-world-02",
                "launchEnglish": "The river sets the year. Spring runs fill the narrows. Summer opens the banks. Autumn draws food from forest and water. Winter pulls people back towards dependable channels and what earlier seasons preserved. Long before a field reaches the Danube, its people know how to return, store, exchange and endure."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-river-world-01",
            "narration-ff-river-world-02"
          ],
          "completionEffects": [],
          "checkpoint": "onEntry"
        },
        {
          "id": "beat-first-farmers-household-crosses",
          "sceneID": "scene-first-farmers-aegean-crossing",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-household-crosses-eyebrow",
              "launchEnglish": "7000–6500 BC · Western Anatolia"
            },
            "heading": {
              "id": "beat-first-farmers-household-crosses-heading",
              "launchEnglish": "The Field Crosses the Sea"
            },
            "paragraphs": [
              {
                "id": "ff-crossing-01",
                "launchEnglish": "On the eastern Aegean shore, a household gathers a world small enough to move. Emmer and einkorn wait in sacks. Sheep and goats crowd the waterline. Grinding stones, pots and cutting tools carry the work that stands between seed and bread."
              },
              {
                "id": "ff-crossing-02",
                "launchEnglish": "The knowledge travels inside people. They know when to break the soil, how deep to set the seed, which animals to breed, where to keep grain dry and what must remain untouched for the next sowing. Remove any one part and the rest becomes harder to sustain. Carry the household west."
              }
            ],
            "actionPrompt": {
              "id": "beat-first-farmers-household-crosses-action-prompt",
              "launchEnglish": "Carry the household"
            }
          },
          "narrationCueIDs": [
            "narration-ff-crossing-01",
            "narration-ff-crossing-02"
          ],
          "interaction": {
            "id": "interaction-first-farmers-a-household-crosses",
            "prompt": {
              "id": "interaction-interaction-first-farmers-a-household-crosses-prompt",
              "launchEnglish": "Carry the household"
            },
            "grammar": "trace",
            "configuration": {
              "anchors": [
                {
