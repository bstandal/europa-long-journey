        },
        {
          "id": "beat-first-farmers-living-system",
          "sceneID": "scene-first-farmers-thessaly-landing",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-living-system-eyebrow",
              "launchEnglish": "The Aegean · Thessaly"
            },
            "heading": {
              "id": "beat-first-farmers-living-system-heading",
              "launchEnglish": "Nothing Travels Alone"
            },
            "paragraphs": [
              {
                "id": "ff-system-01",
                "launchEnglish": "The sacks do not make a farm. Seed requires cleared ground and a season of labour. Animals require water, breeding and winter care. Grain requires cutting, drying, threshing, grinding and a store that can defeat damp, insects and hunger. The household carries the links together."
              },
              {
                "id": "ff-system-02",
                "launchEnglish": "Children learn by working beside adults. No written manual crosses the sea. Skill lives in hands, timing and repetition. When new houses rise in Thessaly, the field has arrived as a living system: people, plants, animals, tools and memory bound into one practice."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-system-01",
            "narration-ff-system-02"
          ],
          "completionEffects": [],
          "checkpoint": "onEntry"
        },
        {
          "id": "beat-first-farmers-european-ground",
          "sceneID": "scene-first-farmers-thessaly-first-season",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-european-ground-eyebrow",
              "launchEnglish": "Thessaly"
            },
            "heading": {
              "id": "beat-first-farmers-european-ground-heading",
              "launchEnglish": "The First Season Takes Hold"
            },
            "paragraphs": [
              {
                "id": "ff-ground-01",
                "launchEnglish": "A roof closes against rain. Hooves mark the same enclosure night after night. A strip of earth darkens under the digging stick. The work is modest, but its direction is absolute. A household has opened European ground to the next sowing."
              },
              {
                "id": "ff-ground-02",
                "launchEnglish": "Other households follow. Some routes turn through the Balkans and up the Danube; others run along Mediterranean coasts and islands. The journeys differ. The cargo remains joined. Farming spreads because people move with the complete practice and make it durable wherever they settle."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-ground-01",
            "narration-ff-ground-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        },
        {
          "id": "beat-first-farmers-inhabited-frontier",
          "sceneID": "scene-first-farmers-danube-arrival",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-inhabited-frontier-eyebrow",
              "launchEnglish": "The Danube Corridor"
            },
            "heading": {
              "id": "beat-first-farmers-inhabited-frontier-heading",
              "launchEnglish": "The Route Reaches an Inhabited River"
            },
            "paragraphs": [
              {
                "id": "ff-frontier-01",
                "launchEnglish": "The route now bends north towards the gorge. Its newcomers do not meet wilderness. River communities already possess houses, graves, boats and exchange roads older than the field. They know the current, the forest and distant stone. The arriving household brings another kind of permanence."
              },
              {
                "id": "ff-frontier-02",
                "launchEnglish": "Before these lives can meet, the harvest makes its first demand. What grows in one season must carry a household through the next."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-frontier-01",
            "narration-ff-frontier-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        }
      ]
    },
    {
      "id": "first-farmers-arc-02",
      "title": {
        "id": "first-farmers-arc-02-title",
        "launchEnglish": "The Harvest Had to Last"
      },
      "targetDurationMinutes": 9,
      "situation": {
        "id": "first-farmers-arc-02-situation",
        "launchEnglish": "A farming household faces winter, spoilage and the obligation to reserve seed for the next sowing."
      },
      "mechanism": {
        "id": "first-farmers-arc-02-mechanism",
        "launchEnglish": "Food, reserve and seed compete inside one finite store while river and farming communities exchange people and practices."
      },
      "turn": {
        "id": "first-farmers-arc-02-turn",
        "launchEnglish": "Grain eaten now cannot answer scarcity or return to the soil."
      },
      "consequence": {
        "id": "first-farmers-arc-02-consequence",
        "launchEnglish": "Farming becomes a discipline of deferred use and inherited obligation."
      },
      "handoff": {
        "id": "first-farmers-arc-02-handoff",
        "launchEnglish": "Once stores and households endure, the settlement itself can outlive its builders."
      },
      "beats": [
        {
          "id": "beat-first-farmers-harvest-allocation",
          "sceneID": "harvest-allocation-option-1",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-harvest-allocation-eyebrow",
              "launchEnglish": "6500–6000 BC · Thessaly"
            },
            "heading": {
              "id": "beat-first-farmers-harvest-allocation-heading",
              "launchEnglish": "The Harvest Had to Last"
            },
            "paragraphs": [
              {
                "id": "ff-harvest-01",
                "launchEnglish": "A field changed the shape of the year. The grain before you has been cut, dried and threshed. Nothing more will grow before winter. This store must answer three claims."
              },
              {
                "id": "ff-harvest-02",
                "launchEnglish": "Part will be eaten. Grain carried to the hearth becomes winter food. Once consumed, it cannot answer a longer season or return to the soil."
              },
              {
                "id": "ff-harvest-03",
                "launchEnglish": "Part must be kept against loss. Dry grain is lifted from the earth and closed away from damp, insects and hungry animals."
              },
              {
                "id": "ff-harvest-04",
                "launchEnglish": "And part must remain untouched. Seed grain is food refused in winter: the next field held inside the present harvest."
              },
              {
                "id": "ff-harvest-05",
                "launchEnglish": "Meet every obligation. What remains can ease winter, absorb loss or enlarge the next sowing. The same grain cannot do all three."
              }
            ],
            "actionPrompt": {
              "id": "beat-first-farmers-harvest-allocation-action-prompt",
              "launchEnglish": "Divide the harvest"
            }
          },
          "narrationCueIDs": [
            "narration-ff-harvest-01",
            "narration-ff-harvest-02",
            "narration-ff-harvest-03",
            "narration-ff-harvest-04",
            "narration-ff-harvest-05"
          ],
          "interaction": {
            "id": "interaction-first-farmers-the-harvest-had-to-last",
            "prompt": {
              "id": "interaction-interaction-first-farmers-the-harvest-had-to-last-prompt",
              "launchEnglish": "Divide the harvest"
            },
            "grammar": "allocate",
