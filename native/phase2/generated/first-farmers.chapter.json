            "heading": {
              "id": "beat-first-farmers-continent-remade-heading",
              "launchEnglish": "A Continent Remade"
            },
            "paragraphs": [
              {
                "id": "ff-continent-01",
                "launchEnglish": "The first traced household has become a continental pattern. Fields break woodland along river valleys and fertile plains. Herds move between enclosure, water and pasture. Longhouses, wells and inherited plots hold growing communities to ground."
              },
              {
                "id": "ff-continent-02",
                "launchEnglish": "Carry the transformation across Europe. Keep the river beneath it. Keep the first route visible. The new landscape does not erase what came before; it makes fields, stores and permanent settlement the dominant structure through which later powers must move."
              }
            ],
            "actionPrompt": {
