        {
          "id": "beat-first-farmers-plot-remains",
          "sceneID": "scene-first-farmers-longhouse-rebuilt",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-plot-remains-eyebrow",
              "launchEnglish": "The Same Plot · Another Generation"
            },
            "heading": {
              "id": "beat-first-farmers-plot-remains-heading",
              "launchEnglish": "Timber Fails. The Place Endures."
            },
            "paragraphs": [
              {
                "id": "ff-plot-01",
                "launchEnglish": "Posts rot. Walls crack. Thatch gives way. Yet the path still reaches the threshold. The well remains. Worked ground surrounds the house, and old postholes hold its shape beneath the floor."
              },
              {
                "id": "ff-plot-02",
                "launchEnglish": "New timbers rise beside the old marks. The rebuilt house inherits more than a footprint. Cleared soil, stored grain, animal enclosures and neighbourly obligations make one generation's labour part of the life awaiting the next."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-plot-01",
            "narration-ff-plot-02"
          ],
