        {
          "id": "beat-first-farmers-stored-future",
          "sceneID": "scene-first-farmers-store-committed",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-stored-future-eyebrow",
              "launchEnglish": "One Harvest · Three Futures"
            },
            "heading": {
              "id": "beat-first-farmers-stored-future-heading",
              "launchEnglish": "The Year Is Bound"
            },
            "paragraphs": [
              {
                "id": "ff-stored-future-01",
                "launchEnglish": "Nothing has been created. The harvest has been divided across present hunger, future loss and the field to come. Every valid choice leaves the same obligation behind: winter consumption must stop before it consumes the grain kept for sowing."
              },
              {
                "id": "ff-stored-future-02",
                "launchEnglish": "A missed fishing day can be answered by another current. A failed agricultural season reaches months ahead. The store turns memory into discipline. It makes survival depend on work already done and restraint maintained long after the field has gone dark."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-stored-future-01",
            "narration-ff-stored-future-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        },
        {
          "id": "beat-first-farmers-gorge-contact",
          "sceneID": "scene-first-farmers-iron-gates-contact",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-gorge-contact-eyebrow",
              "launchEnglish": "6200–5800 BC · The Iron Gates"
            },
            "heading": {
              "id": "beat-first-farmers-gorge-contact-heading",
              "launchEnglish": "Two Ways of Living Meet"
            },
            "paragraphs": [
              {
                "id": "ff-contact-01",
                "launchEnglish": "At the gorge, fish and hides move towards the newcomers. Pottery, grain and domestic animals move towards the river settlements. Stone already travels through networks the farmers did not create. Boats carry every exchange more easily than the forest."
              },
              {
                "id": "ff-contact-02",
                "launchEnglish": "The meeting enters daily life. Some river people take selected practices. Some join farming settlements. Some farming households include partners raised on the Danube. Goods, skills and people cross at different speeds, until neither bank contains the world it held before."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-contact-01",
            "narration-ff-contact-02"
          ],
          "completionEffects": [],
          "checkpoint": "onEntry"
        },
        {
          "id": "beat-first-farmers-three-records",
          "sceneID": "scene-first-farmers-iron-gates-transformation",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-three-records-eyebrow",
              "launchEnglish": "The Gorge Through Time"
            },
            "heading": {
              "id": "beat-first-farmers-three-records-heading",
              "launchEnglish": "Set the Records Together"
            },
            "paragraphs": [
              {
                "id": "ff-records-01",
                "launchEnglish": "One moment cannot contain the frontier. Move the same riverbank through three states: the gorge before local farming, the generations of contact, and the later settlements in which farming has taken hold while river food and local ancestry remain."
              },
              {
                "id": "ff-records-02",
                "launchEnglish": "The change is visible only when the records stand together. A settlement can receive grain before every household farms. A person can move before a practice does. A river route can survive while its cargo changes."
              }
            ],
            "actionPrompt": {
              "id": "beat-first-farmers-three-records-action-prompt",
              "launchEnglish": "Move the gorge through three generations"
            }
          },
          "narrationCueIDs": [
            "narration-ff-records-01",
            "narration-ff-records-02"
          ],
          "interaction": {
            "id": "interaction-first-farmers-at-the-iron-gates",
            "prompt": {
