        },
        {
          "id": "beat-first-farmers-paternal-lines",
          "sceneID": "scene-first-farmers-household-descent",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-paternal-lines-eyebrow",
              "launchEnglish": "Household · Descent · Place"
            },
            "heading": {
              "id": "beat-first-farmers-paternal-lines-heading",
              "launchEnglish": "The House Acquires a Line"
            },
            "paragraphs": [
              {
                "id": "ff-descent-01",
                "launchEnglish": "In some farming communities, continuity runs strongly through fathers and sons. Women arrive from neighbouring groups and bind settlements to one another. The house plot, its dead and its worked ground give descent a durable address."
              },
              {
                "id": "ff-descent-02",
                "launchEnglish": "A family line can now inherit a store, a field and obligations fixed to place. Long before law writes property down, repeated work makes possession visible in the earth."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-descent-01",
            "narration-ff-descent-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        },
        {
          "id": "beat-first-farmers-more-mouths",
