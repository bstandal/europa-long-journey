        {
          "id": "beat-first-farmers-growth-breaks",
          "sceneID": "scene-first-farmers-local-contraction",
          "narrative": {
            "eyebrow": {
              "id": "beat-first-farmers-growth-breaks-eyebrow",
              "launchEnglish": "Growth Is Not a Straight Line"
            },
            "heading": {
              "id": "beat-first-farmers-growth-breaks-heading",
              "launchEnglish": "Some Clearings Empty"
            },
            "paragraphs": [
              {
                "id": "ff-contraction-01",
                "launchEnglish": "Expansion carries its own exposure. A failed harvest, disease, conflict or exhausted local ground can break a settlement's growth. Smoke disappears from some roofs. Grass closes paths. Young trees enter worked soil."
              },
              {
                "id": "ff-contraction-02",
                "launchEnglish": "The farming system survives by moving again. Households take seed, animals and learned routines to another clearing. Population rises and falls by region, yet every renewed settlement extends the world of fields and stores."
              }
            ]
          },
          "narrationCueIDs": [
            "narration-ff-contraction-01",
            "narration-ff-contraction-02"
          ],
          "completionEffects": [],
          "checkpoint": "onExit"
        },
        {
          "id": "beat-first-farmers-continent-remade",
