        def Material "mat_aegean_earth" (
            prepend apiSchemas = ["ColorSpaceAPI"]
            displayName = "mat-aegean-earth"
        )
        {
            uniform token colorSpace:name = "lin_rec709_scene"
            token outputs:surface.connect = </western_anatolia_aegean/_materials/mat_aegean_earth/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "mat-aegean-earth"
            custom string userProperties:commercial_rights = "project-authored-no-external-assets"
            custom string userProperties:pbr_authoring = "procedural-noise-color-bump+usd-preview-surface"
            custom string userProperties:runtime_name = "mat-aegean-earth"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.25
                color3f inputs:diffuseColor = (0.22, 0.2, 0.135)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.97
                float inputs:specular = 0.5
                token outputs:surface

            }

        }

