#usda 1.0
(
    defaultPrim = "western_anatolia_aegean"
    doc = "Blender v5.2.0 LTS"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "western_anatolia_aegean" (
    prepend apiSchemas = ["ColorSpaceAPI"]
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
    displayName = "western-anatolia-aegean"
)
{
    uniform token colorSpace:name = "lin_rec709_scene"
    custom string userProperties:asset_version = "aegean-crossing-v1"
    custom string userProperties:runtime_name = "western-anatolia-aegean"
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

