---
import "../styles/chapter.css";
import "../styles/chapter-steppe.css";
import "../styles/chapter-bronze.css";
import "../styles/chapter-greece.css";
import "../styles/chapter-rome.css";
import "../styles/chapter-christian.css";
import "../styles/chapter-carolingian.css";
import "../styles/chapter-papal.css";
import "../styles/chapter-kin.css";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description: string;
  theme: string;
};

const { title, description, theme } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass={`deep-chapter-page deep-chapter-page--${theme}`}
>
  <script is:inline slot="head">
    document.documentElement.classList.add("chapter-js");
  </script>
  <slot />
  <NewsletterSignup variant="floating" />
  <script>
    import "../scripts/newsletter-signup";
  </script>
</BaseLayout>
