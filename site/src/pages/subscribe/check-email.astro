---
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Check your inbox — EUROPA"
  description="Confirm your email address for updates from EUROPA."
  bodyClass="subscription-status-page"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <SiteHeader section="sources" />
  <script is:inline>
    try {
      window.localStorage.setItem(
        "europa:newsletter:pending:v1",
        String(Date.now()),
      );
      window.localStorage.removeItem("europa:newsletter:dismissed:v1");
    } catch {}
  </script>
  <main id="main-content" class="subscription-status">
    <p class="subscription-status__overline">THE JOURNEY CONTINUES</p>
    <h1>One more step.</h1>
    <p>
      Check your inbox and open the message from EUROPA. Your address is not added
      until you use the confirmation link.
    </p>
    <p class="subscription-status__note">
      If it has not arrived after a few minutes, check your spam folder and make
      sure the address was typed correctly.
    </p>
    <a href={`${base}#top`}>Return to the long road</a>
  </main>
</BaseLayout>

<style>
  :global(.subscription-status-page) {
    min-height: 100svh;
    background:
      radial-gradient(circle at 70% 20%, rgba(184, 149, 85, 0.11), transparent 38%),
      #11181e;
  }

  .subscription-status {
    width: min(720px, calc(100% - 48px));
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(150px, 22svh, 230px) 0 90px;
  }

  .subscription-status__overline {
    margin: 0 0 18px;
    color: var(--bronze-bright);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
  }

  h1 {
    margin: 0 0 28px;
    font-family: var(--serif);
    font-size: clamp(3.7rem, 10vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  p {
    max-width: 650px;
    margin: 0;
    color: rgba(240, 230, 206, 0.82);
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.42rem);
  }

  .subscription-status__note {
    margin-top: 22px;
    color: rgba(240, 230, 206, 0.58);
    font-family: var(--sans);
    font-size: 0.82rem;
  }

  a {
    display: inline-flex;
    min-height: 44px;
    margin-top: 52px;
    align-items: center;
    border-bottom: 1px solid rgba(224, 189, 115, 0.55);
    color: var(--ivory);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
  }

  a:focus-visible {
    outline: 2px solid var(--bronze-bright);
    outline-offset: 5px;
  }
</style>
