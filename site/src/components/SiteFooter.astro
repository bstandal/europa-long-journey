---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isPrivacyPage = pathname.endsWith("/privacy/");
const isSourcesPage = pathname.endsWith("/sources/");
---

<footer class="site-footer">
  <p>EUROPA</p>
  <nav aria-label="Footer navigation">
    <a href={base}>The journey</a>
    <a href={`${base}sources/`} aria-current={isSourcesPage ? "page" : undefined}>
      Sources
    </a>
    <a href={`${base}privacy/`} aria-current={isPrivacyPage ? "page" : undefined}>
      Privacy
    </a>
  </nav>
</footer>
