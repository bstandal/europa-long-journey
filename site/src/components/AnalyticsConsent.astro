---
const base = import.meta.env.BASE_URL;
const analyticsWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const analyticsScriptUrl =
  import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim() ||
  "https://cloud.umami.is/script.js";
const analyticsDomains =
  import.meta.env.PUBLIC_UMAMI_DOMAINS?.trim() || Astro.url.hostname;
---

{
  analyticsWebsiteId && (
    <>
      <div
        data-europa-analytics-config
        data-script-url={analyticsScriptUrl}
        data-website-id={analyticsWebsiteId}
        data-domains={analyticsDomains}
        hidden
      />
      <section
        id="analytics-consent"
        class="analytics-consent"
        data-analytics-consent
        aria-label="Optional analytics"
        hidden
      >
        <p class="analytics-consent__copy">
          May we measure visits, reading progress, interactions, device type and
          approximate country? No name or email. Change anytime.{" "}
          <a href={`${base}privacy/#privacy-analytics`}>Details</a>.
        </p>
        <div
          class="analytics-consent__actions"
          role="group"
          aria-label="Analytics choice"
        >
          <button
            type="button"
            data-analytics-choice="granted"
            aria-pressed="false"
          >
            Accept
          </button>
          <button
            type="button"
            data-analytics-choice="denied"
            aria-pressed="false"
          >
            Decline
          </button>
        </div>
      </section>
    </>
  )
}
