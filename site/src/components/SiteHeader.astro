---
const base = import.meta.env.BASE_URL;
type Props = { section?: "journey" | "sources" };
const { section = "journey" } = Astro.props;
---

<header class="site-header" data-site-header>
  <a class="wordmark" href={`${base}#top`} aria-label="EUROPA home">EUROPA</a>
  <nav class="header-nav" aria-label="Primary navigation">
    {
      section === "journey" ? (
        <button class="nav-button" type="button" data-open-index aria-haspopup="dialog">
          <i class="ph ph-list" aria-hidden="true" />
          <span>Chapters</span>
        </button>
      ) : (
        <a class="nav-button" href={`${base}#steppe-comes-west`}>
          <i class="ph ph-arrow-left" aria-hidden="true" />
          <span>The journey</span>
        </a>
      )
    }
  </nav>
</header>
