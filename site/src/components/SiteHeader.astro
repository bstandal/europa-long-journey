---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;
type Props = { section?: "journey" | "sources" | "privacy" };
const { section = "journey" } = Astro.props;
---

<header class="site-header" data-site-header>
  <a class="wordmark" href={`${base}#top`} aria-label="EUROPA home">EUROPA</a>
  <nav class="header-nav" aria-label="Primary navigation">
    {
      section === "journey" ? (
        <button class="nav-button" type="button" data-open-index aria-haspopup="dialog">
          <Icon name="list" />
          <span>Chapters</span>
        </button>
      ) : (
        <a class="nav-button" href={`${base}#first-farmers`}>
          <Icon name="arrow-left" />
          <span>The journey</span>
        </a>
      )
    }
  </nav>
</header>
