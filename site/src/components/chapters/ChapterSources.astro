---
import { sources } from "../../data/sources";
import type { ChapterDefinition } from "../../types/chapter";

type Props = {
  chapter: ChapterDefinition;
};

const { chapter } = Astro.props;
const usedIds = new Set(chapter.movements.flatMap((movement) => movement.sourceIds));
const usedSources = sources.filter((source) => usedIds.has(source.id));
---

<section class="chapter-sources" aria-labelledby="chapter-sources-title">
  <div>
    <p class="chapter-sources__eyebrow">Archaeology · ancient DNA · palaeopathology</p>
    <h2 id="chapter-sources-title">What survived</h2>
  </div>
  <ol>
    {
      usedSources.map((source) => (
        <li>
          <span>{source.author}</span>
          {source.url ? <a href={source.url}>{source.title}</a> : <cite>{source.title}</cite>}
          <small>{source.publication ? `${source.publication}, ` : ""}{source.year}</small>
        </li>
      ))
    }
  </ol>
</section>
