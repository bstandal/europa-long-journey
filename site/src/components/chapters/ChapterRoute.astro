---
import type { ChapterDefinition } from "../../types/chapter";

type Props = {
  chapter: ChapterDefinition;
};

const { chapter } = Astro.props;
const base = import.meta.env.BASE_URL;
const routePoints = chapter.movements
  .map((movement) => `${movement.map.x},${movement.map.y}`)
  .join(" ");
const firstMovement = chapter.movements[0];
const firstAct = chapter.acts?.find((act) => act.id === firstMovement.actId);
const hasActs = Boolean(chapter.acts?.length);
---

<aside
  class:list={["chapter-route", { "chapter-route--acts": hasActs }]}
  data-chapter-route
  aria-label={chapter.mapLabel}
>
  <button
    class="chapter-route__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="chapter-route-panel"
    data-route-toggle
  >
    <span>
      <small data-route-toggle-act>{firstAct ? `Act ${firstAct.number}` : chapter.number}</small>
      <strong data-route-toggle-place>{firstMovement.place}</strong>
    </span>
    <span aria-hidden="true">Map</span>
  </button>
  <div class="chapter-route__panel" id="chapter-route-panel" data-route-panel>
    <div class="chapter-route__map" aria-hidden="true">
      <img
        class="chapter-route__base-map"
        src={`${base}${chapter.routeImage ?? "assets/europe-relief.webp"}`}
        alt=""
        width="1536"
        height="1024"
        decoding="async"
      />
      {
        chapter.openingRouteImage && (
          <img
            class="chapter-route__opening-map"
            src={`${base}${chapter.openingRouteImage}`}
            alt=""
            width="1536"
            height="768"
            decoding="async"
          />
        )
      }
      <svg viewBox="0 0 100 100" preserveAspectRatio="none">
        <polyline points={routePoints}></polyline>
      </svg>
      {
        chapter.movements.map((movement, index) => (
          <span
            class:list={["chapter-route__marker", { "is-active": index === 0 }]}
            style={`--route-x:${movement.map.x}%;--route-y:${movement.map.y}%`}
            data-route-marker={movement.id}
          ></span>
        ))
      }
    </div>
    <div class="chapter-route__current" aria-live="polite">
      {firstAct && <small data-route-act>Act {firstAct.number} · {firstAct.title}</small>}
      <span data-route-period>{firstMovement.period}</span>
      <strong data-route-place>{firstMovement.place}</strong>
    </div>
    {
      chapter.acts && (
        <nav class="chapter-route__acts" aria-label="Acts in this chapter">
          {chapter.acts.map((act, index) => {
            const actMovement = chapter.movements.find(
              (movement) => movement.actId === act.id,
            );
            return (
              <a
                href={`#act-${act.id}`}
                class:list={{ "is-active": index === 0 }}
                data-route-act-link={act.id}
                data-route-act-movement={actMovement?.id}
                data-route-act-number={act.number}
                data-route-act-title={act.title}
                aria-current={index === 0 ? "step" : undefined}
              >
                <span>Act {act.number}</span>
                {act.title}
              </a>
            );
          })}
        </nav>
      )
    }
    <nav class="chapter-route__movements" aria-label="Places and dates in this history">
      {
        chapter.movements.map((movement, index) => (
          <a
            href={`#${movement.id}`}
            class:list={{ "is-active": index === 0 }}
            data-route-link={movement.id}
            data-route-act-id={movement.actId}
            data-route-period-value={movement.period}
            data-route-place-value={movement.place}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span>{movement.period}</span>
            {movement.place}
          </a>
        ))
      }
    </nav>
  </div>
</aside>
