---
import type { ChapterDefinition } from "../../types/chapter";

type Props = {
  chapter: ChapterDefinition;
};

const { chapter } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="chapter-stage" data-chapter-stage aria-hidden="true">
  <div class="chapter-stage__images">
    {
      chapter.movements.map((movement, index) => (
        <img
          class:list={["chapter-stage__image", { "is-active": index === 0 }]}
          src={`${base}${movement.image}`}
          alt=""
          width="1536"
          height="1024"
          fetchpriority={index === 0 ? "high" : undefined}
          loading={index < 2 ? "eager" : "lazy"}
          decoding="async"
          data-stage-image={movement.id}
          style={`object-position:${movement.imagePosition ?? "center"}`}
        />
      ))
    }
    {
      chapter.movements.flatMap((movement) =>
        movement.interaction?.kind === "growth"
          ? movement.interaction.stages.map((state, index) => (
              <img
                class:list={[
                  "chapter-stage__image",
                  "chapter-stage__state-image",
                  { "is-state-active": index === 0 },
                ]}
                src={`${base}${state.image}`}
                alt=""
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
                data-stage-state-owner={movement.id}
                data-stage-state-id={state.id}
              />
            ))
          : [],
      )
    }
    {
      chapter.movements
        .filter((movement) => movement.interaction?.kind === "compare")
        .map((movement) => {
          const compare =
            movement.interaction?.kind === "compare"
              ? movement.interaction
              : undefined;
          if (!compare) return null;
          return (
            <div
              class="chapter-stage__compare"
              data-compare-stage={movement.id}
              style="--compare-progress:50%"
            >
              <img
                src={`${base}${compare.before.image}`}
                alt=""
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
              <div class="chapter-stage__compare-after">
                <img
                  src={`${base}${compare.after.image}`}
                  alt=""
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="chapter-stage__compare-line"></span>
              <p class="chapter-stage__compare-before">
                <strong>{compare.before.label}</strong>
                {compare.before.period}
              </p>
              <p class="chapter-stage__compare-after-label">
                <strong>{compare.after.label}</strong>
                {compare.after.period}
              </p>
            </div>
          );
        })
    }
    {
      chapter.movements.map((movement) => {
        const inheritance =
          movement.interaction?.kind === "inheritance"
            ? movement.interaction
            : undefined;
        if (!inheritance) return null;
        return (
          <div
            class="chapter-stage__inheritance"
            data-inheritance-stage={movement.id}
          >
            <img
              src={`${base}${inheritance.mapImage}`}
              alt=""
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
            />
            {inheritance.layers.map((layer, index) => (
              <div
                class:list={[
                  "chapter-stage__inheritance-layer",
                  { "is-active": index === 0 },
                ]}
                data-inheritance-layer={layer.id}
              >
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                  {layer.routes.map((route) => (
                    <>
                      <polyline
                        points={route.points
                          .map((point) => `${point.x},${point.y}`)
                          .join(" ")}
                      />
                      <circle
                        cx={route.points.at(-1)?.x}
                        cy={route.points.at(-1)?.y}
                        r="0.65"
                      />
                    </>
                  ))}
                </svg>
                <span
                  class="chapter-stage__inheritance-origin"
                  style={`--map-x:${layer.routes[0]?.points[0]?.x ?? 50}%;--map-y:${layer.routes[0]?.points[0]?.y ?? 50}%`}
                >
                  Pontic steppe
                </span>
                {layer.routes.map((route) => (
                  <span
                    class="chapter-stage__inheritance-destination"
                    style={`--map-x:${route.points.at(-1)?.x ?? 50}%;--map-y:${route.points.at(-1)?.y ?? 50}%`}
                  >
                    {route.label}
                  </span>
                ))}
              </div>
            ))}
          </div>
        );
      })
    }
  </div>
  <div class="chapter-stage__shade"></div>
  <div class="chapter-stage__grain"></div>
  <p class="chapter-stage__note">Evidence-led reconstruction</p>
</div>
