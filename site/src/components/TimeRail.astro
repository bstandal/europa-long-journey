---
import { scenes, storyEras } from "../data/scenes";
---

<aside class="time-rail" aria-label="Journey progress" data-time-rail>
  <div class="time-rail__current">
    <span class="time-rail__chapter" data-rail-chapter>01</span>
    <span class="time-rail__year" data-rail-year>7000 BC</span>
    <span class="time-rail__era" data-rail-era>{storyEras[0].label}</span>
  </div>
  <div class="time-rail__track" aria-hidden="true">
    <span class="time-rail__fill" data-rail-fill></span>
  </div>
  <ol class="time-rail__points">
    {
      scenes.map((scene) => (
        <li>
          <a
            href={`#${scene.id}`}
            aria-label={`${scene.title}, ${scene.period.label}`}
            data-rail-link={scene.id}
            data-rail-era-id={scene.era}
          >
            <span></span>
          </a>
        </li>
      ))
    }
  </ol>
  <span class="time-rail__end">NOW</span>
</aside>
