---
import type { StoryScene as StorySceneType } from "../types/story";
import Icon from "./Icon.astro";

type Props = {
  scene: StorySceneType;
};

const { scene } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section
  id={scene.id}
  class:list={["story-scene", `story-scene--${scene.side}`]}
  data-story-scene
  data-scene-id={scene.id}
  data-order={scene.order}
  data-era={scene.era}
  data-latitude={scene.focus.latitude}
  data-longitude={scene.focus.longitude}
  data-camera-x={scene.camera.x}
  data-camera-y={scene.camera.y}
  data-camera-scale={scene.camera.scale}
  data-camera-rotation={scene.camera.rotation ?? 0}
  data-palette={scene.palette}
  data-map-scope={scene.interaction.mapScope}
  data-transition-effect={scene.transitionEffect ?? ""}
>
  <article class="scene-card">
    <div class="scene-card__topline">
      <span class="scene-number">{String(scene.order).padStart(2, "0")}</span>
      <span class="scene-period">{scene.period.label}</span>
      <span class="scene-place">
        <Icon name="map-pin" />
        {scene.landmark}
      </span>
    </div>
    <p class="scene-kicker">{scene.kicker}</p>
    <h2>{scene.title}</h2>
    <p class="scene-thesis">{scene.thesis}</p>
    {
      scene.chronicle && (
        <a class="scene-chronicle" href={`${base}${scene.chronicle.href}`}>
          <span>
            <small>{scene.period.label}</small>
            <strong>{scene.chronicle.label}</strong>
          </span>
          <Icon name="arrow-right" />
        </a>
      )
    }
    <p class="scene-body">{scene.body}</p>
    <div class="scene-card__footer">
      <span class="scene-route-label">
        <Icon name="path" />
        {scene.interaction.prompt}
      </span>
      <span class="scene-explore-label">
        <Icon name="map-pin" />
        {scene.landmark}
      </span>
    </div>
  </article>
</section>
